---
import '@fontsource/space-grotesk/latin-700.css';
import '@fontsource/manrope/latin-400.css';
import '@fontsource/manrope/latin-600.css';
import '../styles/global.css';
import '../styles/audit.css';
import displayFont from '@fontsource/space-grotesk/files/space-grotesk-latin-700-normal.woff2?url';
import { copy, type Lang } from '../data/copy';
const { lang = 'pt', title, description, path = '', alternate = '', noindex = false } = Astro.props as {lang:Lang,title?:string,description?:string,path?:string,alternate?:string,noindex?:boolean};
const t=copy[lang];
const canonical=`https://gustapaz.github.io/${lang}/${path}`;
---
<!doctype html>
<html lang={lang === 'pt' ? 'pt-BR':'en'} data-theme="dark">
<head>
  <meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
  <meta name="color-scheme" content="dark light"/><meta name="theme-color" content="#101014"/>
  <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://api.github.com; object-src 'none'; base-uri 'none'; form-action 'none'"/>
  <title>{title || `Gustavo Paz — ${lang === 'pt' ? 'Engenheiro de Software':'Software Engineer'}`}</title>
  <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin/>
  {noindex&&<meta name="robots" content="noindex,follow"/>}
  <meta name="description" content={description || t.introBody}/><link rel="canonical" href={canonical}/>
  <link rel="alternate" hreflang="pt-BR" href={`https://gustapaz.github.io/pt/${lang === 'pt' ? path:alternate}`}/>
  <link rel="alternate" hreflang="en" href={`https://gustapaz.github.io/en/${lang === 'en' ? path:alternate}`}/>
  <link rel="alternate" hreflang="x-default" href={`https://gustapaz.github.io/pt/${lang==='pt'?path:alternate}`}/>
  <meta property="og:type" content="website"/><meta property="og:title" content={title || `Gustavo Paz — ${lang==='pt'?'Engenheiro de Software':'Software Engineer'}`}/><meta property="og:description" content={description || t.introBody}/><meta property="og:url" content={canonical}/><meta property="og:image" content="https://gustapaz.github.io/social.png"/><meta property="og:locale" content={lang === 'pt' ? 'pt_BR':'en_US'}/><meta property="og:image:alt" content={lang==='pt'?'Gustavo Paz — portfólio de desenvolvimento':'Gustavo Paz — software development portfolio'}/><meta name="twitter:card" content="summary_large_image"/>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
  <script is:inline>try{const s=localStorage.getItem('gp.theme');document.documentElement.dataset.theme=s==='dark'||s==='light'?s:matchMedia('(prefers-color-scheme: light)').matches?'light':'dark';document.documentElement.dataset.motion=matchMedia('(prefers-reduced-motion: reduce)').matches||localStorage.getItem('gp.motion')==='reduced'?'reduced':'full';document.documentElement.dataset.scrollbar=localStorage.getItem('gp.scrollbar')==='visible'?'visible':'hidden'}catch{if(matchMedia('(prefers-color-scheme: light)').matches)document.documentElement.dataset.theme='light'}</script>
</head>
<body data-lang={lang}>
  <a class="skip-link" href="#main">{t.skip}</a>
  <header class="site-header">
    <a class="brand" href={`/${lang}/`} aria-label="Gustavo Paz">GP<span class="brand-dot">.</span></a>
    <nav class="desktop-nav" aria-label={lang === 'pt' ? 'Principal':'Main'}><a href={`/${lang}/#acervo`}>{t.projects}</a><a href={`/${lang}/#sobre`}>{t.about}</a><a href={`/${lang}/#contato`}>{t.contact}</a></nav>
    <div class="header-tools"><div class="language-switch" role="group" aria-label={lang === 'pt' ? 'Idioma':'Language'}><a href={`/pt/${lang === 'pt' ? path:alternate}`} lang="pt-BR" hreflang="pt-BR" aria-current={lang === 'pt' ? 'page':undefined}>PT</a><a href={`/en/${lang === 'en' ? path:alternate}`} lang="en" hreflang="en" aria-current={lang === 'en' ? 'page':undefined}>EN</a></div><button id="theme" class="icon-button" aria-label={t.theme} title={t.theme}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 1v3m0 16v3M1 12h3m16 0h3M4.2 4.2l2.1 2.1m11.4 11.4 2.1 2.1M4.2 19.8l2.1-2.1M17.7 6.3l2.1-2.1"/></svg></button><button id="motion" class="icon-button motion-button" aria-label={t.motion} aria-pressed="false" title={t.motion}><svg class="motion-pause" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6 4h4v16H6zm8 0h4v16h-4z"/></svg><svg class="motion-play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="m7 3 15 9-15 9z"/></svg></button><button id="menu" class="icon-button menu-button" aria-label={t.menu} aria-expanded="false" aria-controls="mobile-menu"><span aria-hidden="true">☰</span></button></div>
  </header>
  <dialog id="mobile-menu" class="mobile-menu" aria-label={lang==='pt'?'Navegação':'Navigation'}><div class="menu-top"><span>GP.</span><button id="close-menu" class="icon-button" aria-label={t.close}>×</button></div><nav aria-label={t.menu}><a href={`/${lang}/#acervo`}>{t.projects}<span>01</span></a><a href={`/${lang}/#sobre`}>{t.about}<span>02</span></a><a href={`/${lang}/#contato`}>{t.contact}<span>03</span></a></nav><p>Gustavo Paz / Software in motion</p></dialog>
  {!noindex&&!path&&<script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'ProfilePage',inLanguage:lang==='pt'?'pt-BR':'en',url:canonical,mainEntity:{'@type':'Person',name:'Gustavo Paz',url:'https://gustapaz.github.io/pt/',jobTitle:lang==='pt'?'Engenheiro de Software':'Software Engineer',sameAs:['https://github.com/gustapaz','https://www.linkedin.com/in/gustapaz/']}}).replaceAll('<','\\u003c')}/>}
  <slot/>
  <footer class="site-footer"><a class="brand" href={`/${lang}/`}>GP.</a><p>{t.footer}</p><div><a href="https://github.com/gustapaz" target="_blank" rel="noopener noreferrer">GitHub</a><a href="https://www.linkedin.com/in/gustapaz/" target="_blank" rel="noopener noreferrer">LinkedIn</a><a href="#main">↑ <span class="sr-only">{t.top}</span></a></div><button id="scrollbar-toggle" class="scrollbar-toggle">{lang==='pt'?'Mostrar barra de rolagem':'Show scrollbar'}</button><small>© {new Date().getFullYear()} Gustavo Paz</small></footer>
  <script>import '../scripts/site';</script>
</body>
</html>
