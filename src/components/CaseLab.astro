---
import '../styles/case-lab.css';
import type { Lang } from '../data/copy';
const {slug,lang}=Astro.props as {slug:string,lang:Lang};const pt=lang==='pt';
---
<section class={`case-lab lab-${slug}`} data-lab={slug} data-lang={lang} aria-labelledby="lab-title">
 <div class="lab-heading"><span class="eyebrow">{pt?'EXPLORAÇÃO INTERATIVA':'INTERACTIVE EXPLORATION'}</span><h2 id="lab-title">{slug==='lastro'?(pt?'Um pedido. Uma reserva.':'One request. One reservation.'):slug==='tandem'?(pt?'Do plano à entrega.':'From plan to delivery.'):slug==='confete'?(pt?'Três formas. Uma combinação.':'Three shapes. One match.'):(pt?'O enquadramento muda tudo.':'Framing changes everything.')}</h2><p>{pt?'Uma ilustração local do conceito. A experiência completa está na demo do projeto.':'A local illustration of the concept. Open the project demo for the full experience.'}</p></div>
 {slug==='lastro'?<div class="lab-surface"><div class="lab-stock"><span>{pt?'DISPONÍVEL':'AVAILABLE'}</span><strong data-stock>3</strong><code>key: portfolio-example</code></div><div class="lab-controls"><button data-tx="reserve">{pt?'Reservar 1 unidade':'Reserve 1 unit'}</button><button data-tx="repeat">{pt?'Repetir o mesmo pedido':'Repeat the same request'}</button><button data-tx="reset">{pt?'Reiniciar':'Reset'}</button></div><p class="lab-status" role="status">{pt?'Sem chamadas à API. Observe o estoque ao repetir a mesma chave.':'No API calls. Watch the stock when repeating the same key.'}</p></div>:slug==='tandem'?<div class="lab-surface"><div class="lab-kanban">{[pt?'Planejar':'Plan',pt?'Construir':'Build',pt?'Entregar':'Ship'].map((label,i)=><div><span>{label}</span><div data-lane={i}>{i===0?['Interface','API','QA'].map(label=><button class="lab-task" data-step="0">{label}<small>{pt?'Mover para Construir':'Move to Build'}</small></button>):null}</div></div>)}</div><p class="lab-status" role="status">{pt?'Ative uma tarefa para avançar de etapa.':'Activate a task to advance it to the next stage.'}</p></div>:slug==='confete'?<div class="lab-surface"><div class="lab-match" role="group" aria-label={pt?'Selecione três formas iguais':'Select three matching shapes'}>{['●','◆','✦','◆','✦','●','✦','●','◆'].map((shape,i)=><button data-shape={shape} aria-pressed="false" aria-label={`${pt?'Peça':'Piece'} ${i+1}: ${shape}`}>{shape}</button>)}</div><button class="lab-reset">{pt?'Reiniciar combinação':'Reset selection'}</button><p class="lab-status" role="status">{pt?'Selecione três formas iguais em qualquer posição.':'Select three matching shapes in any position.'}</p></div>:<div class="lab-surface"><div class="lab-crop"><img src="/media/vertice.webp" alt={pt?'Prévia real do Vértice com enquadramento ajustável':'Actual Vértice preview with adjustable framing'} width="1200" height="750" loading="lazy"/></div><label class="lab-range">{pt?'Enquadramento horizontal':'Horizontal framing'}<input type="range" min="0" max="100" value="50"/><output>50%</output></label></div>}
 <noscript><p>{pt?'Ative JavaScript para explorar os controles locais.':'Enable JavaScript to explore the local controls.'}</p></noscript>
</section>
<script>import '../scripts/case-lab';</script>
