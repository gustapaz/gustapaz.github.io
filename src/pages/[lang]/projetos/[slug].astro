---
import Layout from '../../../components/Layout.astro';
import ApiArt from '../../../components/ApiArt.astro';
import CaseLab from '../../../components/CaseLab.astro';
import { projects } from '../../../data/projects';
import { copy, type Lang } from '../../../data/copy';
export function getStaticPaths(){return ['pt','en'].flatMap(lang=>projects.map(p=>({params:{lang,slug:p.slug},props:{project:p}})))}
const {project:p}=Astro.props, lang=Astro.params.lang as Lang, t=copy[lang], c=p[lang];
const next=projects[(projects.findIndex(item=>item.slug===p.slug)+1)%projects.length];
---
<Layout lang={lang} title={`${p.name} — Gustavo Paz`} description={c.summary} path={`projetos/${p.slug}/`} alternate={`projetos/${p.slug}/`}>
<main id="main" tabindex="-1" class="case-page"><div class="wrap"><a class="text-link back-link" href={`/${lang}/#destaques`}>← {t.caseBack}</a><div class="case-heading"><div><span class="eyebrow">{t.personal} / {t.categories[p.category as keyof typeof t.categories]}</span><h1>{p.name}</h1><h2>{c.tag}</h2></div><p>{c.summary}</p></div><div class="case-visual" style={{viewTransitionName:`project-${p.slug}`}}>{p.image?<img src={p.image} width="1200" height="750" alt={`${t.previewLabel}: ${p.name}`}/>:<ApiArt lang={lang}/>}</div><div class="case-actions"><a class="button primary" href={p.demo} target="_blank" rel="noopener noreferrer">{t.demo}</a><a class="button outline" href={`https://github.com/gustapaz/${p.repo}`} target="_blank" rel="noopener noreferrer">{t.code}</a></div><CaseLab slug={p.slug} lang={lang}/><div class="case-content"><aside><span class="eyebrow">{t.stack}</span><ul>{p.stack.map(s=><li>{s}</li>)}</ul></aside><div><section><h2>{t.challenge}</h2><p>{c.challenge}</p></section><section><h2>{t.solution}</h2><p>{c.solution}</p></section><section><h2>{t.decisions}</h2><ol>{c.decisions.map(d=><li>{d}</li>)}</ol></section><section><h2>{t.validation}</h2><p>{c.validation}</p><a class="text-link" href={`https://github.com/gustapaz/${p.repo}#readme`} target="_blank" rel="noopener noreferrer">README</a></section></div></div><a class="next-project" href={`/${lang}/projetos/${next.slug}/`}><span>{t.nextProject}</span><strong>{next.name}</strong></a></div></main>
</Layout>
